# ── Claude (the journal's "brain") ───────────────────────────────────────────
# Your raw personal entries are sent only to Claude. Anthropic does not train on
# API data. Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Model throttle (see lib/ai/router.ts). Most calls land on the floor (Haiku);
# the router escalates to the ceiling (Sonnet) only when an entry is rich,
# significant, or for deep passes (synthesis / ask-your-journal).
AI_MODEL_FLOOR=claude-haiku-4-5
AI_MODEL_CEILING=claude-sonnet-4-6

# ── Gemini (scene images — Phase 3) ──────────────────────────────────────────
# Free tier. Only SANITIZED scene prompts (never raw journal text) are sent here.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ── Spend switch ─────────────────────────────────────────────────────────────
# "sample" (default) = every AI feature returns a free local preview; nothing
# calls Anthropic/Gemini. Set to "live" (and add credit) to use real models.
AI_MODE=sample

# ── Access gate ──────────────────────────────────────────────────────────────
# Set a passcode to lock the public URL (protects your API spend). Leave empty
# to disable the gate.
APP_PASSCODE=
