# ── Claude (the journal's "brain") ───────────────────────────────────────────
# Your raw personal entries are sent only to Claude. Anthropic does not train on
# API data. Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Model throttle (see lib/ai/router.ts). Most calls land on the floor (Haiku);
# the router escalates to the ceiling (Sonnet) only when an entry is rich,
# significant, or for deep passes (synthesis / ask-your-journal).
AI_MODEL_FLOOR=claude-haiku-4-5
AI_MODEL_CEILING=claude-sonnet-4-6

# ── Gemini (scene images — Phase 3) ──────────────────────────────────────────
# Free tier. Only SANITIZED scene prompts (never raw journal text) are sent here.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ── Spend switch ─────────────────────────────────────────────────────────────
# Default is "sample" ($0) — every AI feature returns a free local preview.
# Flip to live per-device with the in-app header toggle (no redeploy needed).
# Leave this UNSET to let the toggle decide. Set AI_MODE=live only to force the
# whole deployment live regardless of the toggle.
# AI_MODE=

# ── Access gate ──────────────────────────────────────────────────────────────
# Set a passcode to lock the public URL (protects your API spend). Leave empty
# to disable the gate.
APP_PASSCODE=

# ── Photos on Google Drive (optional) ────────────────────────────────────────
# Attach photos to entries: compressed + encrypted on-device, then stored in a
# "biblio-journal" folder in YOUR Drive (drive.file scope — the app can only
# see files it created). Create an OAuth "Web application" client ID in Google
# Cloud Console (see README) and put it here. This is an identifier, not a
# secret — it's safe in the client bundle.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# ── Encrypted sync (optional) ────────────────────────────────────────────────
# For live multi-device sync, create a Vercel Blob store and connect it to the
# project — Vercel sets BLOB_READ_WRITE_TOKEN automatically. The server stores
# only ciphertext; your passphrase never leaves the browser.
# BLOB_READ_WRITE_TOKEN=
